# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Google Maps Platform Configuration
# Get a production key from Google Cloud Console: https://console.cloud.google.com/google/maps-apis/credentials
# Or get an instant zero-cost prototyping key from Maps Demo Key: https://mapsplatform.google.com/maps-demo-key
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# OpenAI API Configuration (Used for audio Whisper transcription, memory enhancement, translation, DALL-E postcard generation)
OPENAI_API_KEY=sk-your-openai-api-key
